# 이 파일을 secrets.toml 로 복사하고 키를 넣으세요. secrets.toml 은 공유하지 마세요.
# 무료 키 발급: https://openalex.org/settings/api
OPENALEX_API_KEY = "여기에_키"

# Neon Postgres (Neon console → Connect → "Pooled connection" 켜기). sslmode=require 유지.
DATABASE_URL = "postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"

# 관리자 이메일 (?page=db 상태 페이지를 볼 수 있음)
ADMIN_EMAILS = ["you@example.com"]

# Auth0 로그인 (README "Login (Auth0)" 참고). 이 섹션이 없으면 Sign in 버튼이 숨겨지고 데모만 동작.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # 배포 후: https://<app>.streamlit.app/oauth2callback
cookie_secret = "<python -c 'import secrets; print(secrets.token_hex(32))' 결과>"
client_id = "<Auth0 Client ID>"
client_secret = "<Auth0 Client Secret>"
server_metadata_url = "https://<your-tenant>.us.auth0.com/.well-known/openid-configuration"
