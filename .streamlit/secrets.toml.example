# 이 파일을 secrets.toml 로 복사하고 키를 넣으세요. secrets.toml 은 공유하지 마세요.
# 무료 키 발급: https://openalex.org/settings/api
OPENALEX_API_KEY = "여기에_키"

# 개발용 스위치: 내 컴퓨터에서만 씁니다. Streamlit Cloud에는 넣지 않습니다.
# PR_DB = "fake"                      # 실제 DB 대신 cache/fake_db.json 파일을 씀
# PR_DEV_USER = "test1@example.com"   # 로그인 없이 이 이메일로 들어온 것으로 침 ([auth]가 있으면 무시됨)

# DB 접속 정보는 이 줄 위에 적습니다. [auth] 아래에 적으면 [auth] 안의 값으로 읽힙니다.

# 로그인 (Auth0 이메일 코드). 값을 받은 뒤 아래 7줄의 맨 앞 "# "를 지웁니다.
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "길고_무작위인_문자열"
# client_id = "Auth0_Client_ID"
# client_secret = "Auth0_Client_Secret"
# server_metadata_url = "https://여기에_Auth0_Domain/.well-known/openid-configuration"
# client_kwargs = { "prompt" = "login" }
