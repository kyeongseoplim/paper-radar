{
  "name": "Paper Radar · error alert",
  "nodes": [
    {
      "id": "8a249ed5-ecef-5a13-a6aa-9c8796f1e6ef",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "a443cd1c-8b04-57cd-9a18-4572eefd2dbd",
      "name": "Email admin",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "fromEmail": "Paper Radar <you@gmail.com>",
        "toEmail": "you@gmail.com",
        "subject": "={{ 'Paper Radar workflow failed: ' + $json.workflow.name }}",
        "emailFormat": "html",
        "html": "={{ '<p>' + $json.execution.error.message + '</p><p><a href=\"' + $json.execution.url + '\">Open the execution</a></p>' }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "",
          "name": "SMTP (Paper Radar)"
        }
      }
    }
  ],
  "connections": {
    "On workflow error": {
      "main": [
        [
          {
            "node": "Email admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
